{
  "manifest_version": 3,
  "name": "豆包助手",
  "short_name": "豆包助手",
  "version": "0.2.0",
  "author": "Li",
  "homepage_url": "https://github.com/admin0x/doubaokit",
  "description": "豆包 / Dola 提示词库、生成素材无水印下载、Seedance 增强与账号管理工具。By Li - https://github.com/admin0x/doubaokit",
  "minimum_chrome_version": "111",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "scripting",
    "windows",
    "browsingData",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://www.doubao.com/*",
    "https://*.doubao.com/*",
    "https://www.dola.com/*",
    "https://*.dola.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.doubao.com/chat/*",
        "https://*.doubao.com/chat/*",
        "https://www.dola.com/chat/*",
        "https://*.dola.com/chat/*"
      ],
      "js": ["media-kit.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.doubao.com/chat/*",
        "https://*.doubao.com/chat/*",
        "https://www.dola.com/chat/*",
        "https://*.dola.com/chat/*"
      ],
      "js": ["doubao-kit.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.doubao.com/*",
        "https://*.doubao.com/*",
        "https://www.dola.com/*",
        "https://*.dola.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "豆包 / Dola 助手 · 账号管理",
    "default_popup": "popup.html"
  }
}
